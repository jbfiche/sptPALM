# ---------------------------------------------------------------------------
# Example data: keep the small TrackMate spot tables, ignore the heavy files.
# Remove a line below if you want to version that kind of file.
# ---------------------------------------------------------------------------
# Raw movies (about 270 MB each)
examples/**/Raw_data/
*.tif
*.tiff
# TrackMate xml exports (about 15 MB each)
examples/**/*.xml
# MATLAB results files (about 40 MB each)
examples/**/*.mat

# ---------------------------------------------------------------------------
# Output produced when running the analysis on your own data
# ---------------------------------------------------------------------------
output/
outputs/
results/
*_sptPALM_analysis.h5
*_sptPALM_analysis.npz
